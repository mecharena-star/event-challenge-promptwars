# Copy to .env.local. The app is fully functional WITHOUT a key
# (curated ideas are used); a key enables Gemini-written ideas.
# Server-side only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=12000
RATE_LIMIT_PLAN_PER_MIN=30
RATE_LIMIT_IDEAS_PER_MIN=8
